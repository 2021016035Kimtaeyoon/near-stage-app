# Supabase 연결 정보
#
# 이 파일은 예시입니다. 값을 채운 실제 파일은 .env.local 이고 git에 올라가지 않습니다.
# 값은 Supabase 대시보드 → Project Settings → API 에서 복사합니다.
#
# ★ anon key 는 브라우저에 노출되는 것이 정상입니다. 보안은 RLS(행 수준 보안)가 담당합니다.
# ★ service_role key 는 절대 여기 넣지 마세요. 프론트에 들어가면 RLS를 통째로 우회합니다.
#   그 키가 필요한 작업(KOPIS 수집 등)은 Supabase Edge Function 안에서만 씁니다.

VITE_SUPABASE_URL=https://<프로젝트ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# 카카오 REST API 키 — OIDC 로그인의 client_id 역할입니다.
# client_id 는 원래 공개되는 값이라 브라우저 노출이 정상입니다.
# Client Secret 은 여기 넣지 마세요 — Edge Function 시크릿으로만 씁니다.
VITE_KAKAO_REST_API_KEY=<카카오 REST API 키>

# 카카오 JavaScript 키 — 주소→좌표 변환(지오코딩)에 씁니다.
# 브라우저 노출을 전제로 설계된 키이고, 카카오 콘솔의 사이트 도메인 제한으로 보호됩니다.
VITE_KAKAO_JS_KEY=<카카오 JavaScript 키>
